{
  "headers": [
    {
      "source": "/carta/(.*)/fotos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/reservas",
      "destination": "https://reservas.grupochiringuito.com.ar/reservas"
    },
    {
      "source": "/reservas/:path*",
      "destination": "https://reservas.grupochiringuito.com.ar/reservas/:path*"
    }
  ]
}
